# Скопируйте в .env.prod на сервере и заполните значения.
# .env.prod в .gitignore — не коммитьте секреты.

DOMAIN=your-app.duckdns.org
LIVEKIT_DOMAIN=your-livekit.duckdns.org
DUCKDNS_API_TOKEN=your-duckdns-token

POSTGRES_DB=interview_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=CHANGE_ME_RANDOM_STRING
CORS_ORIGINS=https://your-app.duckdns.org

# Подсказки GigaChat (обязательно для бэкенда)
GIGACHAT_CREDENTIALS=

# STT — SaluteSpeech (gRPC), base64 Basic из кабинета SaluteSpeech
SALUTE_SPEECH_CREDENTIALS=

REDIS_URL=redis://redis:6379/0

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET
LIVEKIT_URL=ws://host.docker.internal:7880

NEXT_PUBLIC_API_URL=https://your-app.duckdns.org
NEXT_PUBLIC_WS_URL=wss://your-app.duckdns.org
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit.duckdns.org
